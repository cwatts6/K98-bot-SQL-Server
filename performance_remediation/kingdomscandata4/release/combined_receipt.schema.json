{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k98.local/schemas/kingdomscandata4-phase5-2-combined-receipt-v1.json",
  "title": "KingdomScanData4 Phase 5.2 combined pre-finalization receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "EvidenceVersion",
    "ReceiptType",
    "RunId",
    "Status",
    "Stage",
    "CapturedAtUtc",
    "EvidenceRoot",
    "TargetPurpose",
    "ServerName",
    "DatabaseName",
    "Phase2RunId",
    "SqlCommit",
    "BotMirrorCommit",
    "ProductionBotCommit",
    "SourceBackup",
    "Migrations",
    "Phase2Digests",
    "ManifestDigests",
    "Gates",
    "SecurityScanIds",
    "Finalizer"
  ],
  "properties": {
    "EvidenceVersion": { "const": 1 },
    "ReceiptType": { "const": "KingdomScanData4Phase52Combined" },
    "RunId": {
      "type": "string",
      "pattern": "^phase5_2_[0-9]{8}T[0-9]{9}Z$"
    },
    "Status": { "const": "PASS" },
    "Stage": { "const": "clean_reapply_pre_finalization" },
    "CapturedAtUtc": { "type": "string", "format": "date-time" },
    "EvidenceRoot": { "type": "string", "minLength": 4 },
    "TargetPurpose": { "enum": ["rehearsal", "production"] },
    "ServerName": { "type": "string", "minLength": 1 },
    "DatabaseName": { "type": "string", "minLength": 1 },
    "Phase2RunId": { "type": "string", "format": "uuid" },
    "SqlCommit": { "$ref": "#/$defs/gitCommit" },
    "BotMirrorCommit": { "$ref": "#/$defs/gitCommit" },
    "ProductionBotCommit": { "$ref": "#/$defs/gitCommit" },
    "SourceBackup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Path",
        "BackupSetPosition",
        "BackupFinishUtc",
        "BackupChecksumPresent",
        "RestoreVerifyOnlyPassed"
      ],
      "properties": {
        "Path": { "type": "string", "minLength": 4 },
        "BackupSetPosition": { "type": "integer", "minimum": 1 },
        "BackupFinishUtc": { "type": "string", "format": "date-time" },
        "BackupChecksumPresent": { "const": true },
        "RestoreVerifyOnlyPassed": { "const": true }
      }
    },
    "Migrations": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "$ref": "#/$defs/migrationPhase2" },
        { "$ref": "#/$defs/migrationPhase3" },
        { "$ref": "#/$defs/migrationPhase4Retire" },
        { "$ref": "#/$defs/migrationPhase4" },
        { "$ref": "#/$defs/migrationPhase5" },
        { "$ref": "#/$defs/migrationPhase51" }
      ],
      "items": false
    },
    "Phase2Digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Ks4Rows",
        "Ks5Rows",
        "StagingRows",
        "BaselineKs4Sha256",
        "BaselineKs5Sha256",
        "BaselineStagingSha256",
        "ForwardKs4Sha256",
        "ForwardKs5Sha256",
        "ForwardStagingSha256"
      ],
      "properties": {
        "Ks4Rows": { "type": "integer", "minimum": 0 },
        "Ks5Rows": { "type": "integer", "minimum": 0 },
        "StagingRows": { "type": "integer", "minimum": 0 },
        "BaselineKs4Sha256": { "$ref": "#/$defs/sha256" },
        "BaselineKs5Sha256": { "$ref": "#/$defs/sha256" },
        "BaselineStagingSha256": { "$ref": "#/$defs/sha256" },
        "ForwardKs4Sha256": { "$ref": "#/$defs/sha256" },
        "ForwardKs5Sha256": { "$ref": "#/$defs/sha256" },
        "ForwardStagingSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "ManifestDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SqlModulesSha256",
        "ChangedFilesSha256",
        "ValidationEvidenceSha256"
      ],
      "properties": {
        "SqlModulesSha256": { "$ref": "#/$defs/sha256" },
        "ChangedFilesSha256": { "$ref": "#/$defs/sha256" },
        "ValidationEvidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "Gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Forward",
        "Rollback",
        "CleanReapply",
        "DatabaseIntegrity",
        "SqlContracts",
        "BotImmutableHandoff",
        "SourceUnchanged",
        "Workload",
        "Security"
      ],
      "properties": {
        "Forward": { "const": "PASS" },
        "Rollback": { "const": "PASS" },
        "CleanReapply": { "const": "PASS" },
        "DatabaseIntegrity": { "const": "PASS" },
        "SqlContracts": { "const": "PASS" },
        "BotImmutableHandoff": { "const": "PASS" },
        "SourceUnchanged": { "const": "PASS" },
        "Workload": { "const": "PASS" },
        "Security": { "const": "PASS" }
      }
    },
    "SecurityScanIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "Finalizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ScriptRelativePath", "ScriptSha256"],
      "properties": {
        "ScriptRelativePath": {
          "const": "performance_remediation\\kingdomscandata4\\phase2\\03_finalize.sql"
        },
        "ScriptSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["MigrationId", "Sha256"],
      "properties": {
        "MigrationId": { "type": "string" },
        "Sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "migrationPhase2": {
      "allOf": [
        { "$ref": "#/$defs/migration" },
        { "properties": { "MigrationId": { "const": "20260725_001_kingdomscandata4_shadow_type_remediation" } } }
      ]
    },
    "migrationPhase3": {
      "allOf": [
        { "$ref": "#/$defs/migration" },
        { "properties": { "MigrationId": { "const": "20260726_001_phase3_import_concurrency_and_direct_type_alignment" } } }
      ]
    },
    "migrationPhase4Retire": {
      "allOf": [
        { "$ref": "#/$defs/migration" },
        { "properties": { "MigrationId": { "const": "20260727_000_retire_vAllianceActivity_WeeklyCumulative" } } }
      ]
    },
    "migrationPhase4": {
      "allOf": [
        { "$ref": "#/$defs/migration" },
        { "properties": { "MigrationId": { "const": "20260727_001_phase4_view_type_alignment" } } }
      ]
    },
    "migrationPhase5": {
      "allOf": [
        { "$ref": "#/$defs/migration" },
        { "properties": { "MigrationId": { "const": "20260728_001_phase5_immutable_import_file_handoff" } } }
      ]
    },
    "migrationPhase51": {
      "allOf": [
        { "$ref": "#/$defs/migration" },
        { "properties": { "MigrationId": { "const": "20260816_001_phase5_1_claim_acl_hardening" } } }
      ]
    }
  }
}
